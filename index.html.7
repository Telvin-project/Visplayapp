{id:'forever-maybe',title:'Forever, Maybe',creator:'purple',category:'Romance',runtime:'1h 29m',date:0,poster:'https://images.unsplash.com/photo-1478720568477-152d9b164e26?auto=format&fit=crop&w=700&q=85',description:'A heartfelt story of timing, love and one more chance.'}];
const demoVideo='https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4';
let balance=0, authMode='signup', toastTimer;let watchlist=[],watchHistory=[];let demoUser=null,creatorApplication='not-applied',movieLikes={},movieComments={};
function creator(id){return creators.find(c=>c.id===id)||creators[0]}
function safe(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function notify(s){let t=$('toast');t.textContent=s;t.style.display='block';clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.style.display='none',3500)}
function card(m){let c=creator(m.creator);return `<article class="movie"><div class="poster" role="button" tabindex="0" aria-label="Watch ${safe(m.title)}" style="background-image:url('${m.poster}')" onclick="openMovie('${m.id}')" onkeydown="if(event.key==='Enter')openMovie('${m.id}')"><span class="tag price-tag">₦100 to watch</span><div class="poster-title">${safe(m.title)}</div></div><div class="movie-info"><div class="movie-name" role="button" tabindex="0" onclick="openMovie('${m.id}')" onkeydown="if(event.key==='Enter')openMovie('${m.id}')">${safe(m.title)}</div><div class="movie-meta">${safe(m.category)} · ${m.runtime} · 5-min preview</div><div class="creator-row"><img class="avatar" src="${c.avatar}" alt="${safe(c.name)}" onclick="event.stopPropagation();openChannel('${c.id}')" onerror="this.style.visibility='hidden'"><button class="creator-link" onclick="openChannel('${c.id}')">${safe(c.name)}</button><button class="share-small" aria-label="Share movie" onclick="shareMovie('${m.id}')">↗</button></div></div></article>`}
function renderShelf(id,list){$(id).innerHTML=list.map(card).join('')}
function setupShelves(){renderShelf('trendingShelf',movies.slice(0,7));renderShelf('dramaShelf',movies.filter(m=>m.category==='Drama'));renderShelf('newShelf',[...movies].sort((a,b)=>b.date-a.date));renderShelf('comedyShelf',movies.filter(m=>m.category==='Comedy'));renderShelf('premiereShelf',[movies[2],movies[3],movies[0]]);renderShelf('allShelf',movies);renderShelf('premieresAll',[movies[2],movies[3],movies[0]])}
function showScreen(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));$(id).classList.add('active');$('searchForm').classList.toggle('search-hidden',id!=='homeScreen');window.scrollTo({top:0,behavior:'smooth'})}
function goHome(fromHistory=false){if(!fromHistory)window.history.pushState({visplayScreen:'homeScreen'},'',location.pathname+location.search);showScreen('homeScreen')}
function goSection(section){goHome();let el=section==='trending'?'trendingShelf':'allShelf';$(el).scrollIntoView({behavior:'smooth',block:'start'})}
function openMovie(id,fromHistory=false){let m=movies.find(x=>x.id===id);if(!m)return;watchHistory=[id,...watchHistory.filter(x=>x!==id)];const c=creator(m.creator);$('movieContent').innerHTML=`<div class="section-head"><div><div class="sub">${safe(m.category)} · ${m.runtime}</div><h1 class="detail-title">${safe(m.title)}</h1></div><button class="secondary" onclick="shareMovie('${m.id}')">↗ Share</button></div><div class="player-box"><video id="movieVideo" controls controlsList="nodownload noplaybackrate" disablePictureInPicture="false" autoplay muted playsinline webkit-playsinline preload="metadata" poster="${m.poster}" aria-label="Demo preview for ${safe(m.title)}"><source src="${demoVideo}" type="video/mp4">Your browser does not support video playback.</video><div class="player-controls"><button class="secondary" onclick="enablePiP()">▣ Picture-in-Picture</button><button class="secondary" onclick="shareMovie('${m.id}')">↗ Share movie</button></div><div class="player-note">Demo sample footage, not the actual movie. Downloads are not offered. Picture-in-Picture depends on browser and device support.</div></div><div class="detail-actions"><button class="primary" onclick="unlockMovie('${m.id}')">Unlock full movie · ₦100</button><button class="secondary" onclick="toggleWatchlist('${m.id}')">${watchlist.includes(m.id)?'✓ In watchlist':'♡ Add to watchlist'}</button></div><div class="creator-row" style="margin:12px 0 15px"><button style="padding:0;border:0;background:transparent" aria-label="Open ${safe(c.name)} channel" onclick="openChannel('${c.id}')"><img class="avatar" style="width:40px;height:40px;flex-basis:40px" src="${c.avatar}" alt="${safe(c.name)}"></button><button class="creator-link" style="font-size:14px" onclick="openChannel('${c.id}')">${safe(c.name)} · View channel ↗</button></div><p class="description">${safe(m.description)}</p><div class="engagement"><button onclick="likeMovie('${m.id}')">♡ Like (<span id="likeCount-${m.id}">${(movieLikes[m.id]||0)}</span>)</button><button onclick="focusComments('${m.id}')">💬 Comment</button><button onclick="shareMovie('${m.id}')">↗ Share</button></div><div class="panel"><h2>Comments</h2><div class="comment-box"><input id="commentInput-${m.id}" placeholder="Write a comment…" maxlength="500"><button class="primary" onclick="postComment('${m.id}')">Post</button></div><div class="comment-list" id="comments-${m.id}">${(movieComments[m.id]||[]).map(x=>'<p>'+safe(x)+'</p>').join('')||'Be the first to comment.'}</div></div><div class="notice">Playback demonstration: this sample video is used to test the player. Real five-minute previews, secure full-film playback and verified payments will be connected to Firebase, video hosting and Paystack.</div>`;renderShelf('moreMovies',movies.filter(x=>x.creator===m.creator&&x.id!==m.id));if(!fromHistory)window.history.pushState({visplayScreen:'movieScreen',movieId:id},'',`#movie/${id}`);showScreen('movieScreen');const v=$('movieVideo');if(v){v.play().catch(()=>{});v.addEventListener('timeupdate',()=>{if(v.currentTime>=300){v.pause();notify('Your five-minute demo preview has ended. Real movie unlocking will be enabled after secure payment integration.')}})}}
function openChannel(id,fromHistory=false){let c=creator(id),own=movies.filter(m=>m.creator===id);$('channelContent').innerHTML=`<div class="channel-hero"><div class="channel-head"><img class="channel-avatar" src="${c.avatar}" alt=""><div><div class="channel-name">${safe(c.name)}</div><div class="channel-stats">${own.length} demo movies · Independent creator</div></div></div><p class="channel-bio">${safe(c.bio)}</p><button class="primary" onclick="notify('Following will be connected to your account after Firebase setup.')">＋ Follow channel</button> <button class="secondary" onclick="shareChannel('${id}')">↗ Share channel</button></div>`;renderShelf('channelMovies',own);if(!fromHistory)window.history.pushState({visplayScreen:'channelScreen',channelId:id},'',`#channel/${id}`);showScreen('channelScreen')}
async function enablePiP(){const v=$('movieVideo');if(!v){notify('Open a movie first to use Picture-in-Picture.');return}try{if(document.pictureInPictureEnabled&&v.requestPictureInPicture){await v.requestPictureInPicture();return}if(typeof v.webkitSetPresentationMode==='function'){v.webkitSetPresentationMode('picture-in-picture');return}notify('Picture-in-Picture is not available in this browser for this video. Try Safari or Chrome and use the video controls.')}catch(e){notify('Picture-in-Picture could not start. Start playback first, then try again')}}
function openPremieres(){showScreen('premieresScreen')}
function openProfile(){showScreen('profileScreen');$('signedOutProfile').style.display=demoUser?'none':'block';$('signedInProfile').style.display=demoUser?'block':'none';if(demoUser){$('profileGreeting').textContent='Hello, '+demoUser.name;$('profileBalance').textContent='₦'+balance.toLocaleString('en-NG');renderShelf('profileRecentShelf',watchHistory.map(id=>movies.find(m=>m.id===id)).filter(Boolean));$('profileRecentEmpty').style.display=watchHistory.length?'none':'block';$('creatorApplicationStatus').textContent=creatorApplication==='pending'?'Application submitted — awaiting review.':creatorApplication==='approved'?'Approved creator account.':'You have not applied yet.'}}
function openWallet(){showScreen('walletScreen');$('walletBalance').textContent='₦'+balance.toLocaleString('en-NG')}
function demoDeposit(){let amount=Number($('depositAmount').value);if(!Number.isFinite(amount)||amount<100){notify('Enter at least ₦100.');return}balance+=Math.floor(amount);$('walletBalance').textContent='₦'+balance.toLocaleString('en-NG');$('profileBalance').textContent='₦'+balance.toLocaleString('en-NG');notify('Demo balance updated. No real payment was made.')}
function openWatchlist(){renderShelf('watchlistShelf',movies.filter(m=>watchlist.includes(m.id)));$('watchlistEmpty').style.display=watchlist.length?'none':'block';showScreen('watchlistScreen')}
function toggleWatchlist(id){if(watchlist.includes(id))watchlist=watchlist.filter(x=>x!==id);else watchlist.push(id);notify(watchlist.includes(id)?'Added to demo watchlist.':'Removed from demo watchlist.');openMovie(id)}
function openHistory(){renderShelf('historyShelf',watchHistory.map(id=>movies.find(m=>m.id===id)).filter(Boolean));$('historyEmpty').style.display=watchHistory.length?'none':'block';showScreen('historyScreen')}
function unlockMovie(id){if(balance<100){notify('Add funds to your demo wallet first. Real Paystack checkout is not connected yet.');openWallet();return}balance-=100;$('walletBalance').textContent='₦'+balance.toLocaleString('en-NG');notify('Demo unlock only. Real purchases require server-verified Paystack payment.')}
function focusSearch(){showScreen('homeScreen');$('searchInput').focus()}
function openAuth(mode='signup'){authMode=mode;updateAuth();$('authModal').classList.add('open')}
function closeAuth(){$('authModal').classList.remove('open')}
function updateAuth(){let signup=authMode==='signup';$('authTitle').textContent=signup?'Create your account':'Sign in to Visplay';$('authIntro').textContent=signup?'Join Visplay to watch movies, manage your wallet and follow creators.':'Welcome back. Sign in to continue to Visplay.';$('nameField').style.display=signup?'block':'none';$('authName').required=signup;$('authSubmit').textContent=signup?'Create demo account':'Sign in (demo)';$('authToggle').textContent=signup?'Already have an account? Sign in':"New to Visplay? Create an account"}
function toggleAuthMode(){authMode=authMode==='signup'?'signin':'signup';updateAuth()}
$('authForm').addEventListener('submit',e=>{e.preventDefault();demoUser={name:($('authName').value.trim()||$('authEmail').value.split('@')[0]||'Viewer'),email:$('authEmail').value};closeAuth();$('signin').textContent='Profile';notify('Demo session started on this device. Secure account creation requires Firebase setup.');openProfile()})
function applyCreator(){if(!demoUser){notify('Please sign in or create an account before applying.');openAuth('signup');return}if(creatorApplication==='pending'){notify('Your application is awaiting review.');return}if(creatorApplication==='approved'){openCreatorDashboard();return}creatorApplication='pending';openProfile();notify('Creator application saved in this demo. The 5–10 minute review is a target; automatic review/approval needs a connected admin workflow.')}function openCreatorDashboard(){if(!demoUser){notify('Please sign in first.');openAuth('signin');return}if(creatorApplication==='not-applied'){notify('Apply to become a creator first.');openProfile();return}showScreen('creatorDashboardScreen')}function googleSignInDemo(){notify('Google sign-in requires Firebase Authentication and the Google provider to be configured.')}function likeMovie(id){movieLikes[id]=(movieLikes[id]||0)+1;const el=$('likeCount-'+id);if(el)el.textContent=movieLikes[id];notify('Like recorded for this demo.')}function focusComments(id){const el=$('commentInput-'+id);if(el)el.focus()}function postComment(id){if(!demoUser){notify('Please sign in to comment.');openAuth('signin');return}const el=$('commentInput-'+id),value=el&&el.value.trim();if(!value)return;(movieComments[id]||(movieComments[id]=[])).unshift(demoUser.name+': '+value);$('comments-'+id).innerHTML=movieComments[id].map(x=>'<p>'+safe(x)+'</p>').join('');el.value=''}function toggleDrawer(open){$('drawer').classList.toggle('open',open)}
async function copyText(text){try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(text);notify('Link copied. Paste it into WhatsApp or anywhere you like.')}else{let t=document.createElement('textarea');t.value=text;t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();let ok=document.execCommand('copy');t.remove();ok?notify('Link copied.'):prompt('Copy this link:',text)}}catch(e){prompt('Copy this link:',text)}}
async function shareLink(url,title){try{if(navigator.share){await navigator.share({title:title||'Watch on Visplay',text:'Watch on Visplay. Sign in and pay to watch the full movie.',url});}else{await copyText(url);notify('Link ready to share. Choose WhatsApp, Facebook or another app from your share menu if available.')}}catch(e){if(e.name!=='AbortError')copyText(url)}}function shareMovie(id){shareLink(location.origin+location.pathname+'#movie/'+id,'Watch on Visplay')}
function shareChannel(id){shareLink(location.origin+location.pathname+'#channel/'+id,'Visplay creator channel')}
$('searchForm').addEventListener('submit',e=>{e.preventDefault();let q=$('searchInput').value.trim().toLowerCase();let found=movies.filter(m=>(m.title+' '+m.category+' '+creator(m.creator).name).toLowerCase().includes(q));$('searchLabel').textContent=q?'Results for “'+q+'”':'All movies';renderShelf('searchResults',found);$('searchEmpty').style.display=found.length?'none':'block';showScreen('searchScreen')})
function routeHash(){let h=location.hash;if(h.startsWith('#movie/'))openMovie(h.slice(7),true);else if(h.startsWith('#channel/'))openChannel(h.slice(9),true);else showScreen('homeScreen')}
window.addEventListener('popstate',e=>{const st=e.state;if(st&&st.visplayScreen==='movieScreen'&&st.movieId)openMovie(st.movieId,true);else if(st&&st.visplayScreen==='channelScreen'&&st.channelId)openChannel(st.channelId,true);else showScreen('homeScreen')});
window.history.replaceState({visplayScreen:'homeScreen'},'',location.pathname+location.search);
$('year').textContent=new Date().getFullYear();setupShelves();routeHash();window.addEventListener('hashchange',routeHash)
</script></body></html>
