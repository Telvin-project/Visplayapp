<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#090711"><title>Visplay — Movies worth watching</title>
<style>
:root{--bg:#090711;--panel:#151121;--panel2:#201631;--purple:#8b5cf6;--pink:#df35f5;--cyan:#00dff5;--muted:#aaa3bd;--line:#30243f}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#fff;font-family:Arial,Helvetica,sans-serif}button,input,select{font:inherit}button{cursor:pointer}
header{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;padding:11px 15px;background:#090711f5;border-bottom:1px solid var(--line);backdrop-filter:blur(14px)}
.brand{font-size:26px;font-weight:900;letter-spacing:-1.3px;white-space:nowrap;background:linear-gradient(100deg,var(--cyan),#4e69ff,var(--pink));-webkit-background-clip:text;background-clip:text;color:transparent;border:0;padding:0;background-color:transparent}
.icon-btn{background:transparent;color:white;border:0;font-size:24px;padding:4px}.search{display:flex;flex:1;min-width:0;max-width:600px;margin:auto;border:1px solid #382947;border-radius:28px;overflow:hidden;background:var(--panel)}.search input{min-width:0;width:100%;padding:11px 14px;color:#fff;background:transparent;border:0;outline:0}.search button,.primary{border:0;background:linear-gradient(100deg,#6d28d9,#bd27e8);color:#fff;padding:11px 16px;font-weight:bold}.search.search-hidden{display:none}.engagement{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.engagement button{border:1px solid #49365d;border-radius:20px;padding:9px 13px;background:#191222;color:#fff}.comment-box{display:flex;gap:8px;margin:10px 0}.comment-box input{flex:1;min-width:0;background:#0b0812;color:#fff;border:1px solid #473354;border-radius:8px;padding:10px}.comment-list{font-size:13px;color:#d6cbe5;line-height:1.6}.signin{border:1px solid var(--purple);border-radius:24px;padding:9px 13px;background:transparent;color:white;white-space:nowrap}
.layout{display:grid;grid-template-columns:210px minmax(0,1fr);max-width:1600px;margin:auto}aside{position:sticky;top:65px;align-self:start;padding:18px 11px;border-right:1px solid #211a30;height:calc(100vh - 65px);overflow:auto}.nav-label{font-size:10px;letter-spacing:1.4px;color:#8f83a5;padding:15px 12px 6px}.nav-item{display:block;width:100%;padding:12px;margin-bottom:4px;text-align:left;color:#d4cde2;background:transparent;border:0;border-radius:10px}.nav-item.active,.nav-item:hover{color:#fff;background:#28183e}
main{min-width:0;padding:18px 22px 30px}.screen{display:none}.screen.active{display:block}.hero{position:relative;min-height:380px;border-radius:18px;overflow:hidden;border:1px solid #4a2a66;background:#21102d;display:flex;align-items:flex-end;margin-bottom:27px;isolation:isolate}.hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(90deg,rgba(5,4,12,.9) 0%,rgba(5,4,12,.48) 48%,rgba(5,4,12,.08) 100%),linear-gradient(0deg,rgba(5,4,12,.86),transparent 65%),url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1800&q=90');background-size:cover;background-position:center 42%;z-index:-1;transform:scale(1.01)}
.hero-content{padding:clamp(20px,4vw,42px);max-width:660px}.ad-chip{display:inline-block;border:1px solid #d58bff;background:#190d2ad9;color:#f4d9ff;border-radius:5px;padding:5px 8px;font-size:10px;font-weight:bold;letter-spacing:.8px}.hero h1{font-size:clamp(34px,5vw,58px);line-height:1.02;margin:13px 0;text-shadow:0 3px 20px #000}.hero p{max-width:510px;color:#e2dbe9;line-height:1.6;font-size:14px}.price-note{display:inline-block;color:#fff;font-size:13px;font-weight:bold;background:#090711bf;border:1px solid #7044a3;border-radius:8px;padding:9px 11px;margin:5px 0 12px}.actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:8px}.primary,.secondary{border-radius:9px;padding:12px 17px}.secondary{border:1px solid #72538d;color:#fff;background:#21172fdc}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:25px 0 13px}h2{font-size:20px;margin:0}.sub{font-size:12px;color:var(--muted);margin-top:5px}.shelf{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:1px 2px 15px;scrollbar-width:thin;scrollbar-color:#59406f transparent}.shelf .movie{flex:0 0 clamp(145px,19vw,220px);scroll-snap-align:start}
.movie{min-width:0;cursor:pointer}.poster{aspect-ratio:3/4;position:relative;display:flex;align-items:flex-end;overflow:hidden;padding:12px;border-radius:10px;background:#201631 center/cover no-repeat;border:1px solid #332344;transition:transform .18s,border-color .18s;isolation:isolate}.poster:hover{transform:translateY(-3px);border-color:#a66ce7}.poster:after{content:"";position:absolute;inset:20% 0 0;background:linear-gradient(transparent,#080611f5);z-index:-0}.poster-title{position:relative;z-index:1;font-size:clamp(13px,1.6vw,18px);font-weight:900;line-height:1.08;text-transform:uppercase;text-shadow:0 2px 12px #000}.tag{position:absolute;z-index:2;top:8px;left:8px;padding:5px 7px;border-radius:5px;font-size:10px;font-weight:bold}.price-tag{background:#21142ce8;border:1px solid #b05cf8}.new-tag{background:#00c8a0;color:#071b18}.movie-info{padding:8px 2px 2px}.movie-name{font-size:13px;font-weight:bold;line-height:1.35}.movie-meta{font-size:11px;color:var(--muted);margin-top:4px}.creator-row{display:flex;align-items:center;gap:7px;margin-top:8px;min-width:0}.avatar{width:27px;height:27px;flex:0 0 27px;border-radius:50%;border:1px solid #9b71db;object-fit:cover;background:#30203f;cursor:pointer}.creator-link{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;color:#d9c9f4;background:none;border:0;padding:0;text-align:left}.creator-link:hover{color:var(--cyan)}.share-small{margin-left:auto;flex:0 0 28px;width:28px;height:28px;border:1px solid #443251;border-radius:50%;background:#191222;color:#e8d8ff}
.empty{display:none;color:var(--muted);padding:28px}.back{border:1px solid #453355;background:#171120;color:white;border-radius:9px;padding:10px 14px;margin-bottom:17px}.detail{display:grid;grid-template-columns:minmax(160px,280px) minmax(0,1fr);gap:23px;align-items:start}.detail-poster{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:13px;border:1px solid var(--line)}.detail-title{font-size:clamp(26px,4vw,42px);margin:8px 0}.detail-actions{display:flex;flex-wrap:wrap;gap:9px;margin:17px 0}.notice{color:#d6cbe5;font-size:12px;line-height:1.6;background:#171120;border:1px solid #342744;border-radius:10px;padding:12px}
.channel-hero,.panel{padding:22px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(125deg,#201331,#10102b);margin-bottom:18px}.channel-head{display:flex;align-items:center;gap:14px}.channel-avatar{width:68px;height:68px;border-radius:50%;object-fit:cover;border:2px solid #a15cff}.channel-name{font-size:23px;font-weight:bold}.channel-stats{font-size:12px;color:var(--muted);margin-top:6px}.channel-bio{color:#c8bed8;font-size:14px;line-height:1.6}
.modal-backdrop{position:fixed;inset:0;background:#000b;z-index:50;display:none;align-items:center;justify-content:center;padding:16px}.modal-backdrop.open{display:flex}.modal{position:relative;width:min(440px,100%);max-height:90vh;overflow:auto;background:#120d1e;border:1px solid #604080;border-radius:17px;padding:22px;box-shadow:0 20px 80px #0009}.modal h2{margin-bottom:8px}.modal p{color:#bdb2ce;font-size:13px;line-height:1.55}.close{position:absolute;right:14px;top:12px;background:none;border:0;color:white;font-size:25px}.field{display:block;margin:13px 0}.field label{display:block;font-size:12px;color:#d4c8e4;margin-bottom:6px}.field input{width:100%;padding:12px;border-radius:8px;border:1px solid #473354;background:#0b0812;color:white}.full{width:100%;margin-top:8px}.link-btn{background:none;border:0;color:#dca7ff;text-decoration:underline;padding:10px 0}.wallet-balance{font-size:35px;font-weight:800;margin:8px 0 16px}.quick-amounts{display:flex;gap:8px;flex-wrap:wrap}.quick-amounts button{border:1px solid #604080;background:#201631;color:white;padding:9px 13px;border-radius:8px}.player-box{background:#000;border-radius:13px;overflow:hidden;border:1px solid #362447}.player-box video{width:100%;max-height:65vh;display:block;background:#000;aspect-ratio:16/9}.player-controls{display:flex;gap:8px;flex-wrap:wrap;padding:10px;background:#151121}.player-note{font-size:12px;color:var(--muted);padding:0 12px 12px}.player-caption{font-size:12px;color:#bdb2ce;padding:10px}.side-drawer{position:fixed;z-index:40;inset:0;background:#0009;display:none}.side-drawer.open{display:block}.drawer-panel{width:min(300px,85vw);height:100%;background:#100b19;padding:20px;border-right:1px solid #49305f}.drawer-panel .brand{margin:6px 0 20px}
footer{text-align:center;color:#8c819e;padding:28px 15px 95px;font-size:12px;border-top:1px solid #211a30;margin-top:30px}.bottom-nav{display:none}#toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#292039;border:1px solid #7650a5;padding:12px 16px;border-radius:12px;display:none;z-index:80;width:max-content;max-width:90%;font-size:13px;box-shadow:0 8px 30px #0008}
@media(max-width:900px){.layout{grid-template-columns:165px minmax(0,1fr)}main{padding:15px}.shelf .movie{flex-basis:clamp(140px,23vw,190px)}}
@media(max-width:600px){header{padding:10px 12px;gap:9px;flex-wrap:wrap}.brand{font-size:24px}.search{order:4;flex-basis:100%;max-width:none}.signin{margin-left:auto;font-size:12px;padding:8px 11px}.menu-top{display:inline-block}.layout{display:block}aside{display:none}main{padding:12px 12px 25px}.hero{min-height:390px;margin-bottom:22px}.hero:before{background-image:linear-gradient(0deg,rgba(5,4,12,.94) 0%,rgba(5,4,12,.28) 65%,rgba(5,4,12,.03) 100%),url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1000&q=90');background-position:center;background-size:cover}.hero-content{padding:20px}.hero h1{font-size:36px}.hero p{font-size:13px}.shelf .movie{flex:0 0 43vw;max-width:205px}.section-head{margin-top:24px}.bottom-nav{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:20;justify-content:space-around;background:#100c1cf5;border-top:1px solid #342744;padding:8px 4px calc(8px + env(safe-area-inset-bottom))}.bottom-nav button{border:0;background:transparent;color:#c7bdd7;font-size:10px;display:grid;gap:4px;justify-items:center}.bottom-nav button span{font-size:20px}.detail{grid-template-columns:100px minmax(0,1fr);gap:13px}.detail-title{font-size:23px}.detail-actions button{font-size:12px;padding:10px}.channel-avatar{width:58px;height:58px}.channel-name{font-size:20px}.channel-hero,.panel{padding:16px}footer{padding-bottom:100px}}
</style></head>
<body>
<header><button class="icon-btn menu-top" onclick="toggleDrawer(true)" aria-label="Open menu">☰</button><button class="brand" onclick="goHome()">Visplay</button><form class="search" id="searchForm"><input id="searchInput" placeholder="Search movies and creators..." aria-label="Search movies and creators"><button type="submit">Search</button></form><button class="signin" id="signin" onclick="demoUser?openProfile():openAuth()">Sign in</button></header>
<div class="layout"><aside>
<button class="nav-item active" onclick="goHome()">⌂ &nbsp; Home</button><button class="nav-item" onclick="goSection('trending')">↗ &nbsp; Trending</button><button class="nav-item" onclick="openPremieres()">◉ &nbsp; Movie premieres</button><button class="nav-item" onclick="openWallet()">▣ &nbsp; My wallet</button><button class="nav-item" onclick="openWatchlist()">♡ &nbsp; Watchlist</button><button class="nav-item" onclick="openHistory()">◷ &nbsp; Watch history</button><div class="nav-label">YOUR VISPLAY</div><button class="nav-item" onclick="openAuth('signup')">＋ &nbsp; Create account</button><button class="nav-item" onclick="applyCreator()">♧ &nbsp; Become a creator</button></aside>
<main>
<section id="homeScreen" class="screen active">
<div class="hero"><div class="hero-content"><span class="ad-chip">FEATURED MOVIE · DEMO PROMOTION</span><h1>THE LAST<br><span style="color:#e3a2ff">PROMISE</span></h1><div class="price-note">Movies from just ₦100 · First 5 minutes free</div><p>A family. A secret. One promise that could change everything. Discover the story everyone will be talking about.</p><div class="actions"><button class="primary" onclick="openMovie('last-promise')">▶ Watch movie</button><button class="secondary" onclick="goSection('trending')">Explore other movies</button></div></div></div>
<div class="section-head"><div><h2>Trending now</h2><div class="sub">Stories viewers are checking out</div></div><span class="sub">Slide to explore →</span></div><div class="shelf" id="trendingShelf"></div>
<div class="section-head"><div><h2>Drama</h2><div class="sub">Stories that stay with you</div></div><span class="sub">Slide →</span></div><div class="shelf" id="dramaShelf"></div>
<div class="section-head"><div><h2>New releases</h2><div class="sub">Fresh stories, independent voices</div></div><span class="sub">Slide →</span></div><div class="shelf" id="newShelf"></div>
<div class="section-head"><div><h2>Comedy</h2><div class="sub">Your next laugh is here</div></div><span class="sub">Slide →</span></div><div class="shelf" id="comedyShelf"></div>
<div class="section-head"><div><h2>Movie premieres</h2><div class="sub">Premiere events and upcoming screenings</div></div><button class="secondary" onclick="openPremieres()">View all</button></div><div class="shelf" id="premiereShelf"></div>
<div class="section-head"><div><h2>All movies</h2><div class="sub">Find your next favourite</div></div></div><div class="shelf" id="allShelf"></div><p id="empty" class="empty">No results found. Try another search.</p>
</section>
<section id="movieScreen" class="screen"><button class="back" onclick="goHome()">← Back</button><div id="movieContent"></div><div class="section-head"><h2>More from this creator</h2></div><div class="shelf" id="moreMovies"></div></section>
<section id="channelScreen" class="screen"><button class="back" onclick="goHome()">← Back</button><div id="channelContent"></div><div class="section-head"><h2>Movies from this creator</h2></div><div class="shelf" id="channelMovies"></div></section>
<section id="profileScreen" class="screen"><div class="section-head"><h2>Your Visplay profile</h2></div><div id="signedOutProfile" class="panel"><h2>Welcome to Visplay</h2><p>Sign in or create an account to manage your wallet, watch history and creator application.</p><button class="primary" onclick="openAuth('signup')">Create account</button> <button class="secondary" onclick="openAuth('signin')">Sign in</button></div><div id="signedInProfile" style="display:none"><div class="panel"><h2 id="profileGreeting">Your account</h2><p>Available wallet balance</p><div class="wallet-balance" id="profileBalance">₦0</div><button class="primary" onclick="openWallet()">＋ Add deposit</button></div><div class="panel"><h2>Become a creator</h2><p>Apply to publish movies on Visplay. You do not need subscribers to start earning. Applications are intended to be reviewed within 5–10 minutes.</p><div id="creatorApplicationStatus" class="sub">You have not applied yet.</div><button class="primary" onclick="applyCreator()">Apply to become a creator</button><button class="secondary" onclick="openCreatorDashboard()">Creator dashboard</button></div><div class="panel"><h2>Recently watched</h2><div class="shelf" id="profileRecentShelf"></div><p id="profileRecentEmpty" class="sub">Movies you open will appear here.</p><button class="secondary" onclick="openHistory()">View watch history</button></div></div></section>
<section id="creatorDashboardScreen" class="screen"><button class="back" onclick="openProfile()">← Back to profile</button><div class="section-head"><h2>Creator dashboard</h2></div><div class="notice">Creator analytics overview. Application status is shown in Profile. Live figures will be connected to verified plays and payments when Firebase/backend integration is complete.</div><div class="panel"><h2>Performance overview</h2><div class="quick-amounts"><div class="panel"><div class="sub">Total views</div><h2 id="creatorViews">0</h2></div><div class="panel"><div class="sub">Paid watches</div><h2 id="creatorPaidViews">0</h2></div><div class="panel"><div class="sub">Estimated earnings</div><h2 id="creatorEarnings">₦0</h2></div></div><p class="sub">Track views, paid watches and earnings from your published movies. No subscriber minimum is required.</p></div><div class="panel"><h2>Your movies</h2><p class="sub">Your uploaded movies and per-title analytics will appear here after creator approval and video hosting setup.</p><button class="primary" onclick="applyCreator()">Creator application / status</button></div></section>
<section id="walletScreen" class="screen"><button class="back" onclick="goHome()">← Home</button><div class="panel"><h2>My wallet</h2><p>Your demo balance on this device. Real deposits will be enabled after secure Paystack integration.</p><div class="wallet-balance" id="walletBalance">₦0</div><div class="field"><label>Choose deposit amount (NGN)</label><input id="depositAmount" type="number" min="100" step="100" value="1000" inputmode="numeric"></div><div class="quick-amounts"><button onclick="$('depositAmount').value=500">₦500</button><button onclick="$('depositAmount').value=1000">₦1,000</button><button onclick="$('depositAmount').value=2000">₦2,000</button><button onclick="$('depositAmount').value=5000">₦5,000</button></div><button class="primary full" onclick="demoDeposit()">＋ Add funds (demo only)</button><div class="notice" style="margin-top:14px">This prototype does not charge your account or move real money. Paystack must be verified on a trusted backend before deposits can be real.</div></div></section>
<section id="premieresScreen" class="screen"><button class="back" onclick="goHome()">← Home</button><div class="hero" style="min-height:250px"><div class="hero-content"><span class="ad-chip">VISPLAY PREMIERES</span><h1>Watch it together.</h1><p>Discover special online premieres from independent filmmakers.</p><button class="primary" onclick="notify('Premiere scheduling will be added when creator accounts and video hosting are connected.')">Host a premiere</button></div></div><div class="section-head"><h2>Featured premieres</h2></div><div class="shelf" id="premieresAll"></div><div class="notice">Premiere listings are demonstration content. Live event scheduling, countdowns, chat and reminders will be added in a later stage.</div></section>
<section id="watchlistScreen" class="screen"><button class="back" onclick="goHome()">← Home</button><h2>Your watchlist</h2><p class="sub">Saved on this device for this demo.</p><div class="shelf" id="watchlistShelf"></div><p id="watchlistEmpty" class="notice">Your watchlist is empty. Open a movie and tap “Add to watchlist”.</p></section>
<section id="historyScreen" class="screen"><button class="back" onclick="goHome()">← Home</button><h2>Watch history</h2><p class="sub">Movies you've opened in this demo.</p><div class="shelf" id="historyShelf"></div><p id="historyEmpty" class="notice">Your watch history is empty.</p></section>
<section id="searchScreen" class="screen"><button class="back" onclick="goHome()">← Home</button><h2>Search results</h2><p class="sub" id="searchLabel"></p><div class="shelf" id="searchResults"></div><p id="searchEmpty" class="notice" style="display:none">No movies or creators found. Try another search.</p></section>
<footer><div class="brand" style="margin-bottom:8px">Visplay</div>Movies from just ₦100 · Preview free for five minutes<br><br>© <span id="year"></span> Visplay · Interactive prototype</footer>
</main></div>
<nav class="bottom-nav"><button onclick="goHome()"><span>⌂</span>Home</button><button onclick="focusSearch()"><span>⌕</span>Search</button><button onclick="openWatchlist()"><span>♡</span>Watchlist</button><button onclick="openProfile()"><span>♙</span>Profile</button><button onclick="openWallet()"><span>▣</span>Wallet</button></nav>
<div id="authModal" class="modal-backdrop" onclick="if(event.target===this)closeAuth()"><div class="modal"><button class="close" onclick="closeAuth()">×</button><h2 id="authTitle">Create your account</h2><p id="authIntro">Join Visplay to watch movies, manage your wallet and follow creators.</p><button class="secondary full" type="button" onclick="googleSignInDemo()">Continue with Google</button><p class="sub">Google sign-in will activate after Firebase Google provider is configured.</p><form id="authForm"><div class="field" id="nameField"><label for="authName">Your name</label><input id="authName" autocomplete="name" placeholder="Enter your name"></div><div class="field"><label for="authEmail">Email address</label><input id="authEmail" type="email" required autocomplete="email" placeholder="you@example.com"></div><div class="field"><label for="authPassword">Password</label><input id="authPassword" type="password" required minlength="6" autocomplete="current-password" placeholder="At least 6 characters"></div><button class="primary full" type="submit" id="authSubmit">Create demo account</button></form><button class="link-btn" id="authToggle" onclick="toggleAuthMode()">Already have an account? Sign in</button><div class="notice">Demo only: this form does not create a secure Firebase account yet. We'll connect Firebase Authentication next.</div></div></div>
<div id="drawer" class="side-drawer" onclick="if(event.target===this)toggleDrawer(false)"><div class="drawer-panel"><button class="close" onclick="toggleDrawer(false)">×</button><div class="brand">Visplay</div><button class="nav-item" onclick="goHome();toggleDrawer(false)">⌂ &nbsp; Home</button><button class="nav-item" onclick="goSection('trending');toggleDrawer(false)">↗ &nbsp; Trending</button><button class="nav-item" onclick="openPremieres();toggleDrawer(false)">◉ &nbsp; Movie premieres</button><button class="nav-item" onclick="openWallet();toggleDrawer(false)">▣ &nbsp; Wallet / Add funds</button><button class="nav-item" onclick="openWatchlist();toggleDrawer(false)">♡ &nbsp; Watchlist</button><button class="nav-item" onclick="openHistory();toggleDrawer(false)">◷ &nbsp; Watch history</button><button class="nav-item" onclick="openProfile();toggleDrawer(false)">♙ &nbsp; Profile / Sign in</button><button class="nav-item" onclick="openAuth('signup');toggleDrawer(false)">＋ &nbsp; Create account</button></div></div>
<div id="toast" role="status"></div>
<script>
const $=id=>document.getElementById(id);
const creators=[
{id:'amara',name:'Amara Films',bio:'Stories about family, courage and the choices that shape us.',avatar:'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=160&q=80'},
{id:'lagos',name:'Lagos Laughs Studio',bio:'Comedy, everyday Lagos life and stories that make you laugh.',avatar:'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=160&q=80'},
{id:'northstar',name:'Northstar Pictures',bio:'Action, suspense and adventures from independent filmmakers.',avatar:'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=160&q=80'},
{id:'purple',name:'Purple Reel Studios',bio:'Romance and human stories about love, hope and second chances.',avatar:'https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=160&q=80'}];
const movies=[
{id:'last-promise',title:'The Last Promise',creator:'amara',category:'Drama',runtime:'1h 42m',date:8,poster:'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=700&q=85',description:'A moving family drama about promises, forgiveness and the courage to begin again.'},
{id:'lagos-wahala',title:'Lagos Wahala',creator:'lagos',category:'Comedy',runtime:'1h 18m',date:7,poster:'https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?auto=format&fit=crop&w=700&q=85',description:'One chaotic day, three friends, and a Lagos plan that goes hilariously wrong.'},
